@startuml User Domain Event Flow

title 用户域事件流程图\nUser Domain Event Flow\nv1.0 - 2024

' 样式定义
skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #333333
    FontSize 11
}

skinparam note {
    BackgroundColor #FFFACD
    BorderColor #DDD
}

' 用户注册流程
partition "用户注册流程" {
    start

    :用户提交注册表单;
    note right: 包含邮箱、密码、昵称等信息

    :RegisterUserCommand;
    note right: 注册用户命令

    :RegisterUserCommandHandler;
    note right
        验证邮箱唯一性
        验证密码强度
        创建用户聚合
    end note

    if (邮箱已存在?) then (是)
        :抛出EmailAlreadyExistsException;
        stop
    else (否)
        :User.register();
        note right
            创建User聚合根
            生成UserId
            加密密码
            设置初始状态为PENDING_VERIFICATION
            生成邮箱验证令牌
        end note

        :保存用户到数据库;

        :发布UserRegistered事件;
        note right
            userId: String (自增ID格式)
            email: String
            registeredAt: LocalDateTime
            ipAddress: String
            verificationToken: String
        end note
    endif

    fork
        :UserProfileProjection;
        note right: 创建用户读模型(未验证状态)
    fork again
        :UserStatisticsProjection;
        note right: 更新用户统计数据
    fork again
        :发送邮箱验证邮件;
        note right: 外部邮件服务
    end fork

    :返回注册成功提示;
    note right: 提示用户查看邮箱进行验证
    stop
}

' 邮箱验证流程
partition "邮箱验证流程" {
    start

    :用户点击验证链接;
    note right: 包含验证令牌

    :VerifyEmailCommand;
    note right: 验证邮箱命令

    :VerifyEmailCommandHandler;
    note right
        查找用户
        验证令牌有效性
        检查令牌是否过期
    end note

    if (用户不存在?) then (是)
        :抛出UserNotFoundException;
        stop
    else (否)
        if (令牌无效或过期?) then (是)
            :抛出InvalidVerificationTokenException;
            stop
        else (否)
            if (用户已验证?) then (是)
                :返回已验证提示;
                stop
            else (否)
                :User.verifyEmail();
                note right
                    验证令牌
                    更新状态为ACTIVE
                    清除验证令牌
                    设置验证时间
                end note

                :保存用户状态变更;

                :发布EmailVerified事件;
                note right
                    userId: String (自增ID格式)
                    email: String
                    verifiedAt: LocalDateTime
                    ipAddress: String
                end note
            endif
        endif
    endif

    fork
        :UserProfileProjection;
        note right: 更新用户验证状态
    fork again
        :UserStatisticsProjection;
        note right: 更新验证用户统计
    fork again
        :发送欢迎邮件;
        note right: 外部邮件服务
    fork again
        :创建默认知识库;
        note right: 知识库域
    end fork

    :返回验证成功页面;
    stop
}

' 重发验证邮件流程
partition "重发验证邮件流程" {
    start

    :用户请求重发验证邮件;
    note right: 提供邮箱地址

    :ResendVerificationEmailCommand;
    note right: 重发验证邮件命令

    :ResendVerificationEmailCommandHandler;
    note right
        查找用户
        检查用户状态
        检查重发频率限制
    end note

    if (用户不存在?) then (是)
        :抛出UserNotFoundException;
        stop
    else (否)
        if (用户已验证?) then (是)
            :返回已验证提示;
            stop
        else (否)
            if (重发过于频繁?) then (是)
                :抛出TooManyRequestsException;
                stop
            else (否)
                :User.regenerateVerificationToken();
                note right
                    生成新的验证令牌
                    更新令牌过期时间
                    记录重发次数
                end note

                :保存令牌变更;

                :发布VerificationEmailResent事件;
                note right
                    userId: String (自增ID格式)
                    email: String
                    newVerificationToken: String
                    resentAt: LocalDateTime
                    resentCount: int
                end note
            endif
        endif
    endif

    :发送新的验证邮件;
    note right: 外部邮件服务

    :返回重发成功提示;
    stop
}

' 用户登录流程
partition "用户登录流程" {
    start

    :用户提交登录表单;
    note right: 包含邮箱、密码

    :LoginUserCommand;
    note right: 用户登录命令

    :LoginUserCommandHandler;
    note right
        查找用户
        验证密码
        检查账户状态
        生成认证令牌
    end note

    if (用户不存在?) then (是)
        :抛出UserNotFoundException;
        stop
    else (否)
        if (密码错误?) then (是)
            :记录失败尝试;
            :抛出InvalidPasswordException;
            stop
        else (否)
            if (邮箱未验证?) then (是)
                :抛出EmailNotVerifiedException;
                note right: 提示用户验证邮箱
                stop
            else (否)
                if (账户被锁定?) then (是)
                    :抛出AccountLockedException;
                    stop
                else (否)
                    :User.login();
                    note right
                        验证密码
                        更新最后登录时间
                        重置失败尝试次数
                    end note

                    :生成JWT令牌;
                    note right: UserAuthenticationService

                    :发布UserLoggedIn事件;
                    note right
                        userId: String (自增ID格式)
                        loginAt: LocalDateTime
                        ipAddress: String
                        sessionId: String
                    end note
                endif
            endif
        endif
    endif

    fork
        :UserProfileProjection;
        note right: 更新最后登录时间
    fork again
        :UserStatisticsProjection;
        note right: 更新登录统计
    fork again
        :记录用户行为;
        note right: 推荐域
    end fork

    :返回AuthToken;
    stop
}

' 用户资料更新流程
partition "用户资料更新流程" {
    start

    :用户提交资料更新;
    note right: 昵称、头像、个人简介等

    :UpdateUserProfileCommand;
    note right: 更新用户资料命令

    :UpdateUserProfileCommandHandler;
    note right
        加载用户聚合
        验证输入数据
        更新用户资料
    end note

    :User.updateProfile();
    note right
        验证昵称长度
        验证个人简介长度
        更新UserProfile实体
        记录变更字段
    end note

    :保存用户变更;

    :发布UserProfileUpdated事件;
    note right
        userId: String (自增ID格式)
        updatedFields: Map<String, Object>
        previousValues: Map<String, Object>
        updatedAt: LocalDateTime
    end note

    fork
        :UserProfileProjection;
        note right: 更新用户读模型
    fork again
        :更新用户偏好;
        note right: 推荐域
    end fork

    :返回成功响应;
    stop
}

' 密码修改流程
partition "密码修改流程" {
    start

    :用户提交密码修改;
    note right: 旧密码、新密码、确认密码

    :ChangePasswordCommand;
    note right: 修改密码命令

    :ChangePasswordCommandHandler;
    note right
        加载用户聚合
        验证旧密码
        验证新密码强度
    end note

    if (旧密码错误?) then (是)
        :抛出InvalidPasswordException;
        stop
    else (否)
        if (新密码不符合策略?) then (是)
            :抛出WeakPasswordException;
            stop
        else (否)
            :User.changePassword();
            note right
                验证旧密码
                加密新密码
                更新密码
                更新修改时间
            end note

            :保存密码变更;

            :发布PasswordChanged事件;
            note right
                userId: String (自增ID格式)
                changedAt: LocalDateTime
                ipAddress: String
                isAdminReset: boolean
            end note
        endif
    endif

    fork
        :发送密码修改通知;
        note right: 邮件服务
    fork again
        :记录安全日志;
        note right: 审计服务
    fork again
        :使所有会话失效;
        note right: 会话管理服务
    end fork

    :返回成功响应;
    stop
}

' 用户状态变更流程
partition "用户状态变更流程" {
    start

    :管理员操作用户状态;
    note right: 激活、停用、暂停等

    switch (操作类型)
    case (激活)
        :ActivateUserCommand;
        note right: 激活用户命令

        :User.activate();
        note right
            检查当前状态
            更新为ACTIVE状态
            记录变更原因
        end note

    case (停用)
        :DeactivateUserCommand;
        note right: 停用用户命令

        :User.deactivate();
        note right
            检查当前状态
            更新为INACTIVE状态
            记录变更原因
        end note

    case (暂停)
        :SuspendUserCommand;
        note right: 暂停用户命令

        :User.suspend();
        note right
            检查当前状态
            更新为SUSPENDED状态
            记录暂停原因
        end note
    endswitch

    :保存状态变更;

    :发布UserStatusChanged事件;
    note right
        userId: String (自增ID格式)
        oldStatus: UserStatus
        newStatus: UserStatus
        changedAt: LocalDateTime
        reason: String
        changedBy: String (自增ID格式)
    end note

    fork
        :UserProfileProjection;
        note right: 更新用户状态
    fork again
        :UserStatisticsProjection;
        note right: 更新状态统计
    fork again
        :发送状态变更通知;
        note right: 通知服务
    fork again
        if (状态为SUSPENDED或INACTIVE) then (是)
            :终止所有会话;
            note right: 会话管理
        endif
    end fork

    :返回成功响应;
    stop
}

' 跨域事件处理
partition "跨域事件处理" {

    :跨域事件发布;
    note right
        用户域发布的事件会被其他域订阅：

        **UserRegistered事件：**
        • 通知域：发送邮箱验证邮件
        • 统计域：更新注册用户数据

        **EmailVerified事件：**
        • 知识库域：创建默认知识库
        • 推荐域：创建用户画像
        • 通知域：发送欢迎消息

        **VerificationEmailResent事件：**
        • 通知域：发送新的验证邮件
        • 统计域：记录重发统计

        **UserLoggedIn事件：**
        • 推荐域：记录用户行为
        • 统计域：更新活跃用户数据

        **UserProfileUpdated事件：**
        • 推荐域：更新用户偏好
        • 搜索域：更新用户索引

        **PasswordChanged事件：**
        • 通知域：发送密码修改通知
        • 审计域：记录安全日志
        • 会话域：使所有会话失效

        **UserStatusChanged事件：**
        • 知识库域：处理访问权限
        • 对话域：处理会话状态
        • 推荐域：暂停推荐服务
        • 会话域：终止用户会话(如果状态为非活跃)
    end note
    
    stop
}

@enduml